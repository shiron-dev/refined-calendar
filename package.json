{
  "name": "vite-project",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "BUILD_ENV=development run-p build:react build:webpack ",
    "build:prod": "run-p build:react build:webpack",
    "build:react": "react-router build",
    "build:webpack": "webpack build --mode production --config ./webpack.config.js",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^7.5.1",
    "@react-router/serve": "^7.5.1",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.1",
    "@shiron-dev/eslint-config": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "copy-webpack-plugin": "^13.0.0",
    "eslint-plugin-format": "^1.0.1",
    "npm-run-all": "^4.1.5",
    "react-router-devtools": "^1.1.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1"
  }
}
